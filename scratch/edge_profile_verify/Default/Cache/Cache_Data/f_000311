  // --------------------------------------------------------------------------
  // 1. DYNAMIC TOP ANNOUNCEMENT BAR (From Supabase banners table / store_settings)
  // --------------------------------------------------------------------------
  async function initAnnouncementBar() {
    const barEl = document.getElementById('sarojini-top-announcement');
    if (!barEl) return;

    try {
      const client = window.supabaseClient || (window.supabase && typeof window.supabase.createClient === 'function' ? window.supabase : null);
      let announcements = [];

      if (client && typeof client.from === 'function') {
        const { data, error } = await client
          .from('banners')
          .select('title, cta_text, cta_link, badge_text, is_active')
          .eq('is_active', true)
          .eq('placement', 'top_announcement')
          .order('sort_order', { ascending: true })
          .limit(5);

        if (!error && Array.isArray(data) && data.length > 0) {
          announcements = data;
        }
      }

      if (announcements.length > 0) {
        let currentIndex = 0;
        const renderAd = (ad) => {
          const badgeHtml = ad.badge_text ? `<span class="announcement-badge">${escapeHtml(ad.badge_text)}</span>` : `<span class="announcement-badge">🔥 BAZAAR ALERT</span>`;
          const ctaHtml = ad.cta_link ? `<a href="${escapeHtml(ad.cta_link)}">${escapeHtml(ad.cta_text || 'Shop Now →')}</a>` : '';
          barEl.innerHTML = `
            <div class="sarojini-announcement-inner">
              ${badgeHtml}
              <span class="announcement-text">${escapeHtml(ad.title)} ${ctaHtml}</span>
            </div>
          `;
        };

        renderAd(announcements[0]);

        if (announcements.length > 1) {
          setInterval(() => {
            currentIndex = (currentIndex + 1) % announcements.length;
            renderAd(announcements[currentIndex]);
          }, 6000);
        }
      } else {
        barEl.innerHTML = `
          <div class="sarojini-announcement-inner">
            <span class="announcement-badge">🛍️ DELHI BAZAAR</span>
            <span class="announcement-text">
              Direct Street Rates Across India • 7-Day Easy Replacements • Cash on Delivery &amp; Open Box Delivery
              <a href="sarojini-shop.html">Explore Street Drops →</a>
            </span>
          </div>
        `;
      }
    } catch (e) {
      console.warn('Sarojini announcement notice:', e);
    }
  }

  // --------------------------------------------------------------------------
  // 2. FETCH BACKEND SECTIONS CONFIGURATION (WITH LOCAL FALLBACK)
  // --------------------------------------------------------------------------
  async function fetchSarojiniSectionsConfig() {
    const STORAGE_KEY = 'sarojini_homepage_sections';
    const client = window.supabaseClient || (window.getSupabase && window.getSupabase()) || (window.supabase && typeof window.supabase.createClient === 'function' ? window.supabase : null);

    let dbSections = null;

    // A. Read store_settings key 'sarojini_homepage_sections'
    if (client && typeof client.from === 'function') {
      try {
        const { data: sRow, error: sErr } = await client
          .from('store_settings')
          .select('value')
          .eq('key', 'sarojini_homepage_sections')
          .maybeSingle();

        if (!sErr && sRow && Array.isArray(sRow.value) && sRow.value.length > 0) {
          dbSections = sRow.value;
        }
      } catch (err) {
        console.warn('Notice reading sarojini_homepage_sections from store_settings:', err);
      }

      // B. Check homepage_sections table for granular section overrides
      try {
        const { data: hpData, error: hpErr } = await client
          .from('homepage_sections')
          .select('*')
          .or('section_type.ilike.sarojini%,content_config->>catalog_type.eq.sarojini');

        if (!hpErr && Array.isArray(hpData) && hpData.length > 0) {
          const hpMap = new Map();
          hpData.forEach(row => {
            if (row.section_type) hpMap.set(row.section_type, row);
            if (row.id) hpMap.set(row.id, row);
          });

          // Merge hpData with dbSections or defaults
          const base = (dbSections && dbSections.length > 0) ? dbSections : JSON.parse(JSON.stringify(DEFAULT_SAROJINI_SECTIONS));
          dbSections = base.map(s => {
            const override = hpMap.get(s.section_type);
            if (override) {
              return {
                ...s,
                title: override.title || s.title,
                subtitle: override.subtitle !== undefined ? override.subtitle : s.subtitle,
                is_active: override.is_active !== undefined ? override.is_active : s.is_active,
                display_order: override.display_order !== undefined ? Number(override.display_order) : s.display_order,
                content_config: { ...(s.content_config || {}), ...(override.content_config || {}) },
                start_date: override.start_date || s.start_date,
                end_date: override.end_date || s.end_date
              };
            }
            return s;
          });
        }
      } catch (hpErr) {
        console.warn('Notice querying homepage_sections:', hpErr);
      }
    }

    // C. Read localStorage cache fallback
    if (!dbSections || dbSections.length === 0) {
      try {
        const cached = localStorage.getItem(STORAGE_KEY);
        if (cached) {
          const parsed = JSON.parse(cached);
          if (Array.isArray(parsed) && parsed.length > 0) {
            dbSections = parsed;
          }
        }
      } catch (_) {}
    }

    // D. Final fallback to DEFAULT_SAROJINI_SECTIONS
    if (!dbSections || dbSections.length === 0) {
      dbSections = JSON.parse(JSON.stringify(DEFAULT_SAROJINI_SECTIONS));
    } else {
      // Ensure all 19 default sections exist even if admin added/removed fields
      const existingTypes = new Set(dbSections.map(s => s.section_type));
      DEFAULT_SAROJINI_SECTIONS.forEach(defSec => {
        if (!existingTypes.has(defSec.section_type)) {
          dbSections.push(JSON.parse(JSON.stringify(defSec)));
        }
      });
    }

    // Sort by display_order ascending
    dbSections.sort((a, b) => (Number(a.display_order) || 0) - (Number(b.display_order) || 0));

    // Save to cache
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(dbSections));
    } catch (_) {}

    return dbSections;
  }

  // --------------------------------------------------------------------------
  // 3. APPLY SECTION ORDER & VISIBILITY TO STOREFRONT DOM
  // --------------------------------------------------------------------------
  function applySectionOrderAndVisibility(sectionsList) {
    if (!Array.isArray(sectionsList) || sectionsList.length === 0) return;

    const mainContainer = document.querySelector('.sarojini-main-content');
    if (!mainContainer) return;

    const now = Date.now();

    sectionsList.forEach(sec => {
      const selectors = SECTION_DOM_MAP[sec.section_type];
      if (!selectors || !selectors.length) return;

      // Determine schedule validity
      let isScheduledActive = sec.is_active !== false;
      if (sec.start_date && new Date(sec.start_date).getTime() > now) {
        isScheduledActive = false;
      }
      if (sec.end_date && new Date(sec.end_date).getTime() < now) {
        isScheduledActive = false;
      }

      selectors.forEach(sel => {
        const el = document.querySelector(sel);
        if (!el) return;

        // Apply visibility
        if (!isScheduledActive) {
          el.style.display = 'none';
        } else {
          // Keep recently viewed hidden initially until items exist
          if (sec.section_type !== 'sarojini_recently_viewed') {
            el.style.display = '';
          }
        }

        // Apply custom Section Titles & Subtitles if provided
        if (sec.title) {
          const heading = el.querySelector('.section-heading') || el.querySelector('h2');
          if (heading && sec.section_type !== 'sarojini_hero') {
            heading.textContent = String(sec.title).replace(/\bVADI\b/g, 'VALORA');
          }
        }
        if (sec.subtitle) {
          const subheading = el.querySelector('.section-subheading') || el.querySelector('.section-desc');
          if (subheading && sec.section_type !== 'sarojini_hero') {
            subheading.textContent = String(sec.subtitle).replace(/\bVADI\b/g, 'VALORA');
          }
        }

        // Special handling for Hero Section config
        if (sec.section_type === 'sarojini_hero' && sec.content_config) {
          const cfg = sec.content_config;
          if (cfg.tagline) {
            const tagEl = el.querySelector('.hero-tagline');
            if (tagEl) tagEl.textContent = cfg.tagline;
          }
          if (cfg.badge_text) {
            const badgeEl = el.querySelector('.sarojini-identity-badge');
            if (badgeEl) badgeEl.innerHTML = `<i class="fas fa-check-circle"></i> ${escapeHtml(cfg.badge_text)}`;
          }
          if (cfg.button_text) {
            const btnEl = el.querySelector('.btn-hero-primary span');
            if (btnEl) btnEl.textContent = cfg.button_text;
          }
          if (cfg.button_link) {
            const btnEl = el.querySelector('.btn-hero-primary');
            if (btnEl) btnEl.setAttribute('href', cfg.button_link);
          }
        }

        // Special handling for Editorial Spotlight Section config
        if (sec.section_type === 'sarojini_spotlight' && sec.content_config) {
          const cfg = sec.content_config;
          if (cfg.pill_text) {
            const pill = el.querySelector('.spotlight-pill');
            if (pill) pill.textContent = cfg.pill_text;
          }
          if (cfg.headline) {
            const h = el.querySelector('.spotlight-title');
            if (h) h.textContent = cfg.headline;
          }
          if (cfg.description) {
            const d = el.querySelector('.spotlight-desc');
            if (d) d.textContent = cfg.description;
          }
          if (cfg.button_text) {
            const b = el.querySelector('.btn-spotlight span');
            if (b) b.textContent = cfg.button_text;
          }
          if (cfg.button_link) {
            const b = el.querySelector('.btn-spotlight');
