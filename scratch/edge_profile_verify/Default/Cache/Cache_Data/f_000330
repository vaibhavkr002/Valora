          <!-- Quantity Selector -->
          <div class="pdp-option-section">
            <div class="pdp-option-header">
              <span class="option-title">Quantity:</span>
            </div>
            <div class="pdp-qty-control">
              <button type="button" class="btn-qty-minus" id="btn-qty-minus">-</button>
              <span class="pdp-qty-val" id="pdp-qty-val">1</span>
              <button type="button" class="btn-qty-plus" id="btn-qty-plus">+</button>
            </div>
          </div>

          <!-- Action CTA Buttons -->
          <div class="pdp-actions-row">
            <button type="button" class="btn-pdp-add-cart" id="btn-pdp-add-bag">
              <i class="fas fa-shopping-bag"></i>
              <span>Add to Bag</span>
            </button>
            <button type="button" class="btn-pdp-buy-now" id="btn-pdp-buy-now">
              <i class="fas fa-bolt"></i>
              <span>Buy Now</span>
            </button>
          </div>

          <!-- Sarojini Bazaar Trust Pillars -->
          <div class="pdp-trust-box">
            <div class="trust-row">
              <i class="fas fa-shield-alt trust-icon"></i>
              <div>
                <strong>Quality Inspected Piece</strong>
                <p>Export surplus and market finds checked for seams, buttons, and stitching.</p>
              </div>
            </div>
            <div class="trust-row">
              <i class="fas fa-truck trust-icon"></i>
              <div>
                <strong>Fast Express Dispatch</strong>
                <p>Direct door-to-door delivery with live tracking.</p>
