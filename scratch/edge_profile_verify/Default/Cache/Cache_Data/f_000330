            </div>
            <div class="trust-row">
              <i class="fas fa-undo-alt trust-icon"></i>
              <div>
                <strong id="pdp-return-title">7-Day Hassle-Free Returns</strong>
                <p>Easy size replacement or refund if you're not 100% satisfied.</p>
              </div>
            </div>
          </div>

          <!-- Pincode Delivery Availability Checker Card (Parity with Main VALORA) -->
          <div id="pincode-checker-card" class="pincode-checker-card" aria-label="Check Delivery Availability">
            <div class="pincode-card-header">
              <div class="pincode-header-left">
                <div class="pincode-icon-badge">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div>
                  <span class="pincode-title">Check Delivery Availability</span>
                  <span class="pincode-subtitle">Enter your 6-digit Indian PIN code to check serviceability &amp; ETA</span>
                </div>
              </div>
              <span class="pincode-free-pill">FREE DELIVERY ₹0</span>
            </div>

            <!-- Input Form Row -->
            <form id="pincode-checker-form" class="pincode-checker-form" onsubmit="return false;" novalidate>
              <div class="pincode-input-wrapper">
                <span class="pincode-input-prefix">🇮🇳</span>
                <input 
                  type="text" 
                  id="pincode-input" 
                  class="pincode-input" 
                  placeholder="Enter 6-digit PIN code (e.g. 110001)" 
                  maxlength="6" 
                  inputmode="numeric" 
                  pattern="[0-9]*" 
                  autocomplete="postal-code"
                  aria-label="6-digit Indian PIN code"
                >
                <button type="button" id="pincode-clear-btn" class="pincode-clear-btn" aria-label="Clear PIN code" style="display:none;">✕</button>
              </div>
              <button type="button" id="pincode-check-btn" class="btn-pincode-check">
                <span class="btn-check-text">Check</span>
                <span class="btn-check-spinner" style="display: none;">
                  <svg class="spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10" stroke="rgba(255,255,255,0.25)"></circle>
                    <path d="M12 2a10 10 0 0 1 10 10" stroke="#ffffff" stroke-linecap="round"></path>
                  </svg>
                </span>
              </button>
            </form>

            <!-- Validation Error Prompt -->
            <div id="pincode-validation-msg" class="pincode-validation-msg" style="display: none;"></div>

            <!-- Success Result State -->
            <div id="pincode-success-box" class="pincode-result-box pincode-success-box" style="display: none;">
              <div class="pincode-result-top">
                <div class="pincode-result-badge success">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>✓ Delivery Available to <strong id="pincode-res-pin">110001</strong></span>
                </div>
                <button type="button" id="pincode-change-btn" class="pincode-change-btn">Change PIN</button>
              </div>
              <div class="pincode-result-details">
                <div class="pincode-detail-row">
                  <span class="pincode-detail-icon">📍</span>
                  <span id="pincode-res-location">New Delhi, Delhi</span>
                </div>
                <div class="pincode-detail-row">
                  <span class="pincode-detail-icon">⚡</span>
                  <span>Estimated Delivery: <strong id="pincode-res-date" class="pincode-eta-highlight">Friday, 18 Sep</strong></span>
                </div>
                <div class="pincode-detail-row">
                  <span class="pincode-detail-icon">🚚</span>
                  <span class="pincode-free-delivery-badge">✓ FREE DELIVERY (₹0)</span>
                </div>
              </div>
            </div>

            <!-- Unserviceable / Error State -->
            <div id="pincode-error-box" class="pincode-result-box pincode-error-box" style="display: none;">
              <div class="pincode-result-top">
                <div class="pincode-result-badge error">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                  <span>Delivery is currently unavailable to this pincode.</span>
                </div>
                <button type="button" id="pincode-retry-btn" class="pincode-change-btn">Try Another</button>
              </div>
              <p class="pincode-unserviceable-note">We are actively expanding our courier network to this destination. Please check with an alternate PIN code or address.</p>
            </div>
          </div>

        </div>

