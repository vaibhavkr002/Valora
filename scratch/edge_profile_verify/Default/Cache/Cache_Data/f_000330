          <!-- Price Row -->
          <div class="pdp-price-box">
            <div class="pdp-price-row">
              <span class="pdp-selling-price" id="pdp-selling-price">₹0</span>
              <span class="pdp-original-price" id="pdp-original-price">₹0</span>
              <span class="pdp-save-badge" id="pdp-save-badge">Save ₹0</span>
