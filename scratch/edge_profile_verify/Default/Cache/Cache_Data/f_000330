                <table class="specs-mini-table">
                  <tbody id="specs-table-body">
                    <tr><th>Material</th><td id="spec-table-material">Premium Cotton Blend</td></tr>
                    <tr><th>Fit Type</th><td id="spec-table-fit">Regular Street Fit</td></tr>
                    <tr><th>Department</th><td id="spec-table-dept">Sarojini Bazaar</td></tr>
                    <tr><th>Care</th><td id="spec-table-care">Machine wash cold, gentle cycle</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
