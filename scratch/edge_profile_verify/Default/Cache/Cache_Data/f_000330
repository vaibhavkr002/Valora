          </div>

          <!-- Payment Options Selector (Full Online vs Advance + COD) -->
          <div class="pdp-payment-options-wrap" style="margin: 18px 0;">
            <div style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 10px;">
              Select Payment Option
            </div>
            <div class="pdp-payment-cards-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              
              <!-- Option 1: Full Online Payment -->
              <div class="pcard-choice selected" id="card-pay-online" data-pay-method="online" role="button" tabindex="0">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                  <span style="font-size: 0.72rem; font-weight: 800; background: #ecfdf5; color: #059669; padding: 2px 6px; border-radius: 4px;">100% ONLINE</span>
                  <div class="pcard-radio-circle active"><div class="pcard-radio-inner"></div></div>
                </div>
                <strong style="display: block; font-size: 0.88rem; color: #0f172a; margin-bottom: 2px;">Pay Full Online</strong>
                <div style="font-size: 0.76rem; color: #64748b;" id="pcard-online-amount-sub">₹0 • ₹0 Advance</div>
              </div>

              <!-- Option 2: Advance + COD -->
              <div class="pcard-choice" id="card-pay-cod" data-pay-method="cod" role="button" tabindex="0">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                  <span style="font-size: 0.72rem; font-weight: 800; background: #fff1f2; color: #e11d48; padding: 2px 6px; border-radius: 4px;" id="pcard-cod-tag">ADVANCE REQ.</span>
                  <div class="pcard-radio-circle"><div class="pcard-radio-inner"></div></div>
                </div>
                <strong style="display: block; font-size: 0.88rem; color: #0f172a; margin-bottom: 2px;">Pay Advance + COD</strong>
                <div style="font-size: 0.76rem; color: #64748b;" id="pcard-cod-amount-sub">Pay advance now</div>
              </div>

            </div>
          </div>

          <!-- Dynamic Advance Payment Notice Banner -->
          <div id="detail-advance-box" style="display: none; margin: 12px 0 18px; padding: 14px 16px; border-radius: 10px; background: #fff1f2; border: 1.5px solid #fecdd3;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; flex-wrap: wrap; gap: 8px;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: #e11d48; color: #fff; font-size: 0.75rem; font-weight: 800;">₹</span>
                <strong id="detail-advance-headline" style="font-size: 0.95rem; color: #be123c; font-weight: 800;">
                  ₹0 Advance Payment Required
                </strong>
              </div>
              <span style="background: rgba(225, 29, 72, 0.12); color: #be123c; font-weight: 800; font-size: 0.7rem; padding: 2px 8px; border-radius: 6px; text-transform: uppercase;">Advance Required</span>
            </div>
            <div id="detail-advance-explainer" style="font-size: 0.84rem; font-weight: 600; color: #475569; margin-top: 4px; line-height: 1.4;">
              Pay ₹0 now • Remaining ₹0 via Cash on Delivery
              <div style="margin-top: 6px; font-size: 0.78rem; font-weight: 500; color: #475569; line-height: 1.4;">Advance payment is required to reduce fake or non-serious COD orders and help us process genuine orders smoothly.</div>
            </div>
          </div>

          <!-- Doorstep Delivery Choice: Simple Delivery vs Open Box Delivery -->
          <div class="pdp-delivery-pref-wrap" style="margin: 16px 0;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <span style="font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b;">Doorstep Handover Choice</span>
              <span style="font-size: 0.72rem; font-weight: 700; color: #e11d48;"><i class="fas fa-shield-alt"></i> Buyer Protection</span>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
              <button type="button" class="btn-delivery-pref selected" id="pref-simple" data-pref="Simple Delivery">
                <div class="pref-radio-dot"></div>
                <div>
                  <strong>Simple Delivery</strong>
                  <span>(Standard Sealed Box)</span>
                </div>
              </button>
              <button type="button" class="btn-delivery-pref" id="pref-openbox" data-pref="Open Box Delivery">
                <div class="pref-radio-dot"></div>
                <div>
                  <strong>Open Box Delivery</strong>
                  <span>(Inspect Before Pay)</span>
                </div>
              </button>
            </div>
          </div>

          <!-- Size Selector -->
          <div class="pdp-option-section" id="pdp-size-section">
            <div class="pdp-option-header">
              <span class="option-title">Select Size:</span>
              <span class="option-selected-label" id="pdp-selected-size-label">Free Size</span>
            </div>
            <div class="pdp-size-pills" id="pdp-size-pills">
