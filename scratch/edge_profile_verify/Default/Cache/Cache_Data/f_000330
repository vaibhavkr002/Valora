        <!-- RIGHT: PRODUCT INFO & PURCHASE CONTROLS -->
        <div class="pdp-info-col">
          
          <div class="pdp-dept-badge-row">
            <span class="pdp-dept-tag" id="pdp-dept-tag">SAROJINI BAZAAR</span>
            <span class="pdp-stock-tag" id="pdp-stock-tag"><i class="fas fa-check-circle"></i> In Stock</span>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;">
            <div>
              <h1 class="pdp-title" id="pdp-title" style="margin-bottom: 4px;">Sarojini Fashion Item</h1>
              <p class="pdp-brand" id="pdp-brand" style="margin-bottom: 6px;">Brand: <strong>Sarojini Bazaar</strong></p>
              <div class="pdp-rating-row" id="pdp-rating-row" style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px; cursor: pointer;">
