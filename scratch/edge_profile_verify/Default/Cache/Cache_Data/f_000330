            </div>
          </div>

          <!-- Color Selector -->
          <div class="pdp-option-section" id="pdp-color-section" style="display: none;">
            <div class="pdp-option-header">
              <span class="option-title">Color:</span>
              <span class="option-selected-label" id="pdp-selected-color-label">Default</span>
            </div>
            <div class="pdp-color-pills" id="pdp-color-pills">
