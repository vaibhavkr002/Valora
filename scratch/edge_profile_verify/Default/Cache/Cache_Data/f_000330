                <span id="pdp-rating-score" style="font-weight: 700; font-size: 0.88rem; color: #0f172a;"></span>
                <span id="pdp-reviews-count" style="font-size: 0.82rem; color: #64748b;"></span>
              </div>
            </div>
            <button type="button" id="btn-toggle-wishlist" class="btn-pdp-wishlist" aria-label="Save to Wishlist" style="background: none; border: 1.5px solid #e2e8f0; width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; color: #64748b; cursor: pointer; transition: all 0.2s;">
