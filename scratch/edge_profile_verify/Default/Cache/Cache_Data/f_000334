/* ============================================================================
   SAROJINI BAZAAR - ANIMATED PROMOTIONAL OVERLAY STRIP
   Elevates product cards with luxury street-market branding while elegantly
   covering unwanted supplier / bottom-edge source codes.
   ============================================================================ */
.sarojini-promo-strip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 34px;
  background: linear-gradient(135deg, #fffdfa 0%, #fff1f3 100%);
  border-top: 1.5px solid rgba(190, 18, 60, 0.28);
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  border-bottom-left-radius: inherit;
  border-bottom-right-radius: inherit;
  box-shadow: 0 -3px 12px rgba(28, 25, 23, 0.08), 0 -1px 3px rgba(190, 18, 60, 0.06);
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 4px 0 6px;
  overflow: hidden;
  pointer-events: none;
  z-index: 4;
  user-select: none;
  box-sizing: border-box;
}

.sarojini-promo-badge {
  background: linear-gradient(135deg, #9f1239 0%, #be123c 100%);
  color: #ffffff;
  font-size: 0.54rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 3px 6px;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  gap: 3.5px;
  line-height: 1;
  flex-shrink: 0;
  box-shadow: 0 1px 3px rgba(159, 18, 57, 0.25);
  z-index: 2;
}

.sarojini-promo-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #facc15;
  box-shadow: 0 0 4px #facc15;
  display: inline-block;
  flex-shrink: 0;
}

.sarojini-promo-ticker {
  position: relative;
  flex: 1;
  height: 100%;
  overflow: hidden;
  min-width: 0;
  display: flex;
  align-items: center;
  mask-image: linear-gradient(90deg, transparent 0%, black 8px, black calc(100% - 8px), transparent 100%);
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 8px, black calc(100% - 8px), transparent 100%);
}

.sarojini-promo-track {
  display: flex;
  width: max-content;
  align-items: center;
  animation: sarojiniContinuousMarquee 11s linear infinite;
  will-change: transform;
}

.sarojini-promo-group {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  flex-shrink: 0;
}

.sarojini-promo-item {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  font-size: 0.63rem;
  font-weight: 750;
  color: #1c1917;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 0 2px;
}

.sarojini-promo-bullet {
  color: #e11d48;
  font-size: 0.68rem;
  font-weight: 900;
  padding: 0 5px;
  opacity: 0.75;
  display: inline-block;
}

.sarojini-promo-heart {
  color: #e11d48;
  font-size: 0.68rem;
  margin-right: 3px;
  display: inline-block;
}

/* Pause animation on card/PDP hover for pleasant readability */
.sarojini-product-card:hover .sarojini-promo-track,
.product-card:hover .sarojini-promo-track,
.pdp-main-media-wrap:hover .sarojini-promo-track {
  animation-play-state: paused;
}

/* Seamless infinite continuous horizontal marquee animation */
@keyframes sarojiniContinuousMarquee {
  0% {
    transform: translateX(0%);
  }
  100% {
    transform: translateX(-50%);
  }
}

/* PDP Main Image Specific Sizing */
.sarojini-promo-strip.sarojini-promo-strip-pdp {
  height: 42px;
  border-top-left-radius: 12px;
  border-top-right-radius: 12px;
  padding: 0 8px 0 10px;
  gap: 8px;
