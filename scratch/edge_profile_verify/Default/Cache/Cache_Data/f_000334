  color: #e2e8f0;
}

/* Specular Shine Sweep across the 3D Board */
.sarojini-card-3d-board .s3d-face-shine {
  content: '';
  position: absolute;
  top: -50%;
  left: -80%;
  width: 50%;
  height: 200%;
  background: linear-gradient(
    105deg,
    transparent 0%,
    rgba(255, 255, 255, 0.05) 25%,
    rgba(255, 255, 255, 0.45) 50%,
    rgba(255, 255, 255, 0.05) 75%,
    transparent 100%
  );
  transform: rotate(25deg);
  animation: sarojini3dBoardShine 4.5s ease-in-out infinite;
  pointer-events: none;
}

/* Floating Soft Elevation Shadow beneath Board */
.sarojini-card-3d-board .s3d-board-shadow {
  position: absolute;
  bottom: -5px;
  left: 10%;
  width: 80%;
  height: 6px;
  background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.42) 0%, rgba(0, 0, 0, 0) 70%);
  filter: blur(2px);
  border-radius: 50%;
  pointer-events: none;
  transition: transform 0.4s ease, opacity 0.4s ease;
}

.sarojini-card-3d-board .s3d-board-shadow.s3d-shadow-turning {
  transform: scale(0.72);
  opacity: 0.28;
}

/* Smooth 3D Board Floating Motion */
@keyframes sarojini3dBoardFloat {
  0% {
    transform: perspective(700px) rotateX(3deg) translateY(0) translateZ(4px);
  }
  50% {
    transform: perspective(700px) rotateX(-2deg) translateY(-2px) translateZ(6px);
  }
  100% {
    transform: perspective(700px) rotateX(3deg) translateY(1.5px) translateZ(4px);
  }
}

/* Subtle Specular Board Shine Sweep */
@keyframes sarojini3dBoardShine {
  0%, 65% {
    left: -80%;
  }
  88%, 100% {
    left: 150%;
  }
}

