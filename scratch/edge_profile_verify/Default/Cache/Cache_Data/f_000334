  font-weight: 800;
  letter-spacing: 0.5px;
  box-shadow: 0 3px 10px rgba(239, 68, 68, 0.35);
  animation: flashPulse 2s infinite ease-in-out;
}

@keyframes flashPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.92; transform: scale(1.02); }
}

.flash-timer-digit {
  font-family: monospace;
  font-size: 0.9rem;
  font-weight: 800;
  background: rgba(0, 0, 0, 0.25);
  padding: 2px 6px;
  border-radius: 4px;
}

/* 3. Shop By Style Grid */
.sarojini-style-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.sarojini-style-card {
  position: relative;
  background: var(--bazaar-surface);
  border: 1px solid var(--bazaar-border);
  border-radius: 14px;
  padding: 18px 16px;
  display: flex;
  align-items: center;
  gap: 14px;
  text-decoration: none;
  transition: all 0.25s ease;
  box-shadow: var(--bazaar-shadow-sm);
}

.sarojini-style-card:hover {
  transform: translateY(-3px);
  border-color: var(--bazaar-terracotta-border);
  box-shadow: 0 8px 20px rgba(28, 25, 23, 0.08);
}

.style-card-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.35rem;
  background: var(--bazaar-surface-warm);
  border: 1px solid var(--bazaar-border);
  flex-shrink: 0;
  transition: background 0.25s ease;
}

.sarojini-style-card:hover .style-card-icon {
  background: #ffffff;
  border-color: var(--bazaar-terracotta);
}

.style-card-text {
  flex: 1;
  min-width: 0;
}

.style-card-title {
  font-size: 0.92rem;
  font-weight: 800;
  color: var(--bazaar-dark);
  margin-bottom: 2px;
}

.style-card-cue {
  font-size: 0.74rem;
  color: var(--bazaar-text-muted);
}

.style-card-arrow {
  color: var(--bazaar-slate);
  font-size: 0.8rem;
  transition: transform 0.2s ease, color 0.2s ease;
}

.sarojini-style-card:hover .style-card-arrow {
  transform: translateX(4px);
  color: var(--bazaar-terracotta);
}

/* 4. Shop By Color Palette */
.sarojini-color-palette {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 14px;
}

.sarojini-color-card {
  background: var(--bazaar-surface);
  border: 1px solid var(--bazaar-border);
  border-radius: 14px;
  padding: 16px 10px;
  text-align: center;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: var(--bazaar-shadow-sm);
}

.sarojini-color-card:hover {
  transform: translateY(-4px);
  border-color: var(--bazaar-terracotta-border);
  box-shadow: 0 8px 22px rgba(28, 25, 23, 0.08);
}

.color-swatch-circle {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  margin-bottom: 10px;
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12);
  border: 2px solid #ffffff;
  transition: transform 0.25s ease;
}

.sarojini-color-card:hover .color-swatch-circle {
  transform: scale(1.12);
}

.color-swatch-name {
  font-size: 0.82rem;
  font-weight: 800;
  color: var(--bazaar-dark);
  margin-bottom: 2px;
}

.color-swatch-cue {
  font-size: 0.7rem;
  color: var(--bazaar-text-muted);
}

/* Responsive adjustments for style & color grids */
@media (max-width: 1024px) {
  .sarojini-vibe-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .sarojini-style-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .sarojini-color-palette {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media (max-width: 768px) {
  .sarojini-vibe-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .sarojini-vibe-card {
    padding: 16px 10px;
  }
  .vibe-card-emoji {
    font-size: 1.8rem;
    margin-bottom: 6px;
  }
  .vibe-card-title {
    font-size: 0.86rem;
  }
  .sarojini-style-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .sarojini-style-card {
    padding: 12px 10px;
    gap: 10px;
  }
  .style-card-icon {
    width: 38px;
    height: 38px;
    font-size: 1.1rem;
  }
  .style-card-title {
    font-size: 0.82rem;
  }
  .sarojini-color-palette {
    display: flex;
    overflow-x: auto;
    padding-bottom: 8px;
    gap: 10px;
    scrollbar-width: none;
  }
  .sarojini-color-palette::-webkit-scrollbar {
    display: none;
  }
  .sarojini-color-card {
    min-width: 105px;
    flex-shrink: 0;
  }
}

