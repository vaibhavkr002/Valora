  font-size: 0.74rem;
  letter-spacing: 0.05em;
}

.sarojini-promo-strip-pdp .sarojini-promo-bullet {
  font-size: 0.8rem;
  padding: 0 7px;
}

/* Responsive Mobile Adjustments */
