# Razorpay API Credentials (Get from Razorpay Dashboard -> Account & Settings -> API Keys)
# In Test Mode, Key ID starts with rzp_test_
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Supabase Project Configuration
# SUPABASE_URL: Your Supabase project URL (e.g. https://your-project-ref.supabase.co)
# SUPABASE_ANON_KEY: Client/Browser anon public key
# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY: Server-side secret key ONLY (e.g. sb_secret_... or service_role JWT)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY
