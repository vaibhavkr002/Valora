{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/terms-and-conditions", "destination": "/terms-and-conditions.html" },
    { "source": "/terms-conditions", "destination": "/terms-and-conditions.html" },
    { "source": "/terms", "destination": "/terms-and-conditions.html" },
    { "source": "/shipping-policy", "destination": "/shipping-policy.html" },
    { "source": "/shipping", "destination": "/shipping-policy.html" },
    { "source": "/return-refund-policy", "destination": "/return-refund-policy.html" },
    { "source": "/returns-exchanges", "destination": "/returns-exchanges.html" },
    { "source": "/returns", "destination": "/returns-exchanges.html" },
    { "source": "/grievance-redressal", "destination": "/grievance-redressal.html" },
    { "source": "/contact-support", "destination": "/contact-support.html" },
    { "source": "/contact", "destination": "/contact-support.html" },
    { "source": "/support", "destination": "/contact-support.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com; connect-src 'self' https://brioiujppaaycydndrcp.supabase.co wss://brioiujppaaycydndrcp.supabase.co https://api.razorpay.com https:; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com; frame-ancestors 'none';"
        }
      ]
    }
  ]
}

